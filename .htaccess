# Airport Route Atlas - Hostinger (Apache/LiteSpeed) config

Options -Indexes

# Force HTTPS. HTTP_X_FORWARDED_PROTO covers requests arriving via a proxy.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
</IfModule>

# CSV is served as a download by default on some hosts; keep it inline text.
<IfModule mod_mime.c>
    AddType text/csv .csv
    AddType font/otf .otf
    AddType image/svg+xml .svg
    AddCharset UTF-8 .csv .css .js .html
</IfModule>

# airports.csv + routes.csv are ~850 KB uncompressed and gzip very well.
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/csv text/plain
    AddOutputFilterByType DEFLATE application/javascript text/javascript
    AddOutputFilterByType DEFLATE image/svg+xml font/otf
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On

    # Entry point: always revalidate so deploys take effect immediately.
    ExpiresByType text/html "access plus 0 seconds"

    # Data and code have no cache-busting hashes, so keep these short.
    ExpiresByType text/csv "access plus 1 hour"
    ExpiresByType text/css "access plus 1 hour"
    ExpiresByType application/javascript "access plus 1 hour"
    ExpiresByType text/javascript "access plus 1 hour"

    # Screenshots only change when the UI is redesigned.
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"

    # Fonts never change; the logo doubles as the favicon.
    ExpiresByType font/otf "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 week"
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
